# Copy to apps/web/.env.local (web) and apps/agent/.env (agent) and fill values.

# Supabase (required for web + agent)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM via OpenRouter (required for agent extraction)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Web search (required for agent discovery)
TAVILY_API_KEY=

# Optional: Jina (free key boosts r.jina.ai reader limits; enables s.jina.ai search)
JINA_API_KEY=

# GitHub dispatch (server-side only; used by research trigger route)
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
